{
  "name": "buildkite-vscode",
  "displayName": "Buildkite",
  "description": "Securely browse and trigger authorized Buildkite pipelines.",
  "version": "0.0.1",
  "publisher": "buildkite-community",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "activationEvents": ["onView:buildkite.explorer"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "buildkite", "title": "Buildkite", "icon": "resources/buildkite.svg" }] },
    "views": { "buildkite": [{ "id": "buildkite.explorer", "name": "Buildkite" }] },
    "viewsWelcome": [
      { "view": "buildkite.explorer", "when": "buildkite.state == disconnected", "contents": "Connect Buildkite with a user API token to browse and trigger your pipelines.\n[Connect Buildkite](command:buildkite.connect)\n[Create an API access token](command:buildkite.openTokenPage)" },
      { "view": "buildkite.explorer", "when": "buildkite.state == noOrganization", "contents": "Choose an organization to continue.\n[Select organization](command:buildkite.changeOrganization)\n[Replace token](command:buildkite.replaceToken)\n[Disconnect](command:buildkite.disconnect)" },
      { "view": "buildkite.explorer", "when": "buildkite.state == authError", "contents": "Buildkite could not authenticate your token. It may have expired or been revoked.\n[Replace token](command:buildkite.replaceToken)\n[Disconnect](command:buildkite.disconnect)" }
    ],
    "commands": [
      { "command": "buildkite.connect", "title": "Buildkite: Connect" },
      { "command": "buildkite.replaceToken", "title": "Replace token" },
      { "command": "buildkite.disconnect", "title": "Disconnect" },
      { "command": "buildkite.changeOrganization", "title": "Change organization" },
      { "command": "buildkite.openTokenPage", "title": "Buildkite: Open API access token page" },
      { "command": "buildkite.changeFolder", "title": "Select workspace folder" },
      { "command": "buildkite.refresh", "title": "Buildkite: Refresh", "icon": "$(refresh)" },
      { "command": "buildkite.searchPipelines", "title": "Buildkite: Search pipelines", "icon": "$(search)" },
      { "command": "buildkite.retry", "title": "Retry", "icon": "$(debug-restart)" },
      { "command": "buildkite.clearFilter", "title": "Buildkite: Clear filter", "icon": "$(close)" },
      { "command": "buildkite.loadMore", "title": "Buildkite: Load more pipelines" },
      { "command": "buildkite.triggerBuild", "title": "Buildkite: Trigger build", "icon": "$(play)" },
      { "command": "buildkite.triggerCurrentProject", "title": "Buildkite: Trigger build for current project", "icon": "$(play)" },
      { "command": "buildkite.openBuild", "title": "Buildkite: Open build in browser", "icon": "$(link-external)" },
      { "command": "buildkite.openBuildPage", "title": "Buildkite: Open build page" }
    ],
    "submenus": [
      { "id": "buildkite.titleActions", "label": "...", "icon": "$(ellipsis)" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "buildkite.openTokenPage", "when": "false" },
        { "command": "buildkite.openBuildPage", "when": "false" },
        { "command": "buildkite.triggerCurrentProject", "when": "false" }
      ],
      "view/title": [
        { "submenu": "buildkite.titleActions", "when": "view == buildkite.explorer && buildkite.state == connected", "group": "navigation" }
      ],
      "buildkite.titleActions": [
        { "command": "buildkite.changeOrganization", "group": "1_organization" },
        { "command": "buildkite.changeFolder", "when": "buildkite.workspaceFolderCount > 1", "group": "1_organization" },
        { "command": "buildkite.replaceToken", "group": "2_token" },
        { "command": "buildkite.disconnect", "group": "3_disconnect" }
      ],
      "view/item/context": [
        { "command": "buildkite.refresh", "when": "view == buildkite.explorer && (viewItem == currentProject || viewItem == currentProjectNoMatch)", "group": "inline" },
        { "command": "buildkite.triggerCurrentProject", "when": "view == buildkite.explorer && viewItem == currentProject", "group": "inline" },
        { "command": "buildkite.refresh", "when": "view == buildkite.explorer && viewItem =~ /^myPipelines/", "group": "inline" },
        { "command": "buildkite.triggerBuild", "when": "view == buildkite.explorer && viewItem =~ /^myPipelines/", "group": "inline" },
        { "command": "buildkite.searchPipelines", "when": "view == buildkite.explorer && viewItem == myPipelines", "group": "inline" },
        { "command": "buildkite.clearFilter", "when": "view == buildkite.explorer && viewItem == myPipelinesFiltered", "group": "inline" },
        { "command": "buildkite.retry", "when": "view == buildkite.explorer && viewItem == errorRow", "group": "inline" },
        { "command": "buildkite.openBuild", "when": "view == buildkite.explorer && viewItem == build", "group": "inline" }
      ]
    }
  },
  "scripts": { "compile": "tsc -p .", "test": "npm run compile && node --test out/test/**/*.test.js" },
  "devDependencies": { "@types/node": "^22.10.1", "@types/vscode": "^1.95.0", "typescript": "^5.7.2" }
}
